# Copy to .env.local (never committed).
#
# Anon key ONLY in client code (desktop + web). Vite exposes VITE_* to the bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ed25519 PUBLIC key for verifying the offline subscription token (TRD §7).
# Safe to ship — it can only verify, never sign. Generate the pair with:
#   node scripts/generate-subscription-keys.mjs
# Leave blank in development: with no key the app cannot verify a token, and
# rather than lock a shop out it leaves gating off (and says so in the log).
VITE_SUBSCRIPTION_PUBLIC_KEY=

# Service-role key: SERVER-SIDE ONLY. Never prefix with VITE_, never import in
# apps/desktop or any client bundle. Used by server routes / scripts only.
SUPABASE_SERVICE_ROLE_KEY=
