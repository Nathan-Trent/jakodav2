# Copy to .env.local (never committed).
#
# Anon key ONLY in client code (desktop + web). Vite exposes VITE_* to the bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: SERVER-SIDE ONLY. Never prefix with VITE_, never import in
# apps/desktop or any client bundle. Used by server routes / scripts only.
SUPABASE_SERVICE_ROLE_KEY=
