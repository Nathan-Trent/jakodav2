{
  "name": "jakodav2",
  "version": "0.1.0",
  "private": true,
  "description": "Invoicing & record-keeping system for Nigerian retail SMEs — modular monolith (TRD §3)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
