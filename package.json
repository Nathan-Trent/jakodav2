{
  "name": "zogal-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Invoicing & record-keeping system for Nigerian retail SMEs \u2014 modular monolith (TRD \u00a73)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "desktop": "npm run dev -w @zogal/desktop",
    "desktop:tauri": "npm run tauri -w @zogal/desktop -- dev",
    "web": "npm run dev -w @zogal/web",
    "web:build": "npm run build -w @zogal/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}