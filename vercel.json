{
  "buildCommand": "npm run web:build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/webapp", "destination": "/webapp/index.html" },
    { "source": "/webapp/(.*)", "destination": "/webapp/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
